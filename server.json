{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Crypto-Goatz/rocket-plus-mcp",
  "description": "50+ AI tools for CRM, content, workflows & marketing automation. GoHighLevel integration.",
  "repository": {
    "url": "https://github.com/Crypto-Goatz/rocket-plus-mcp.git",
    "source": "github"
  },
  "version": "2.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "rocket-plus-mcp",
      "version": "2.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ROCKET_API_KEY",
          "description": "Your Rocket+ API key. Get one at https://rocketadd.com/settings under API Keys.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "ROCKET_API_URL",
          "description": "Rocket+ API base URL (default: https://rocketadd.com)",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
